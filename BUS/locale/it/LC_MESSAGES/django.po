msgid "Further Help"
msgstr "Ulteriore aiuto"

#: .\BUS\templates\BUS\BUShelp.html:109
msgid "For any questions / comments / suggestions, please contact"
msgstr "Per domande, commenti o suggerimenti, contatta"

