{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "jsx": "preserve",
    "types": []
  },
  "vueCompilerOptions": {
    "strictTemplates": false
  },
  "include": [
    "AQY/vueAQY/src/**/*",
    "BUS/vueBUS/src/**/*",
    "CNS/vueCNS/src/**/*",
    "DDL/vueDDL/src/**/*",
    "FCM/vueFCM/src/**/*",
    "IND/vueIND/src/**/*",
    "KFW/vueKFW/src/**/*",
    "PAP/vuePAP/src/**/*",
    "RNB/vueRNB/src/**/*",
    "TGZ/vueTGZ/src/**/*",
    "URR/vueURR/src/**/*",
    "WEB/vueWEB/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "**/static/*vuedist/*",
    ".venv",
    ".venv_local",
    "**/.venv/*",
    "bower_components",
    "tmp",
    "vendor",
    ".git",
    "**/__pycache__"
  ]
}