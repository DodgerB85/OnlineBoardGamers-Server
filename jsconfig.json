{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "jsx": "preserve"
    // ❌ REMOVE THE "paths" BLOCK ENTIRELY FROM THIS FILE
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "WEB/vueWEB/**/*"
  ],
  "exclude": [    
    "node_modules",
    "**/node_modules/*",
    "dist",
    ".venv",
    "**/.venv/*",
    "bower_components",
    "tmp",
    "vendor",
    ".git",
    "**/*.py", 
    "**/__pycache__"
  ]
}
