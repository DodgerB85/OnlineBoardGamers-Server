<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 20" width="200" height="20">
  <rect width="200" height="20" fill="#1a252f" rx="10"/>
  <rect x="0" y="0" width="60" height="20" fill="#e74c3c" rx="10">
    <animate attributeName="x" from="0" to="140" dur="1.5s" repeatCount="indefinite"/>
  </rect>
</svg>