ce label{position:relative;top:20px}.freewayRamps{display:block;display:flex;height:230px;margin:auto;width:700px}.houseHolder,.item_marketing{display:inline-block;position:relative}.gourmetCampaign{float:left;margin:4px;padding:4px;position:relative;z-index:1}.hiring{background-color:#beb6b4}.log,.player.active.displayed,body{background-color:#d4eafd}.houseHolder{margin:5px}.houseHolder .numberHolder{color:#fff;font-size:20px;left:10px;position:absolute;top:7px}.houseHolder.rotated{margin-left:30px}.houseHolder.rotated .numberHolder{color:#fff;font-size:20px;left:95px;position:absolute;top:30px}.iconMiddle{margin:0 12px}.icons img.fixedHeight{height:30px;width:20px!important}.inverted{color:#fff}.item_marketing{height:150px;overflow:hidden;width:100px}.item_marketing img{width:90px}.item_marketing img.campaign{position:relative;top:-60px}.log{border:1px solid #000;direction:ltr;margin:5px;padding:3px 45px 3px 3px}.log .card{margin:2px}.log .food_token{width:25px}.log .food_token.med_thin{width:17px}.log .food_token.thin{width:12px}.log .header{font-size:.8em}.log .new_turn{color:#fff;font-size:1.2em;padding:8px}.log .playerImage,div.miniature div.icons img{width:30px}.log table{border:1px solid #000;border-collapse:collapse;width:100%}.player,.player span{width:120px;display:inline-block}.log table td{border:1px solid #000}.log.separator{padding:3px}.manager{background-color:#241e20}.marketer{background-color:#87c2c8}.newTrainedEmployee{left:-25px;position:relative}.number{font-size:35px}.oldTrainedEmployee{left:25px;position:relative}.player{height:98px;margin:0 10px;overflow:hidden;padding-top:5px;position:relative}div.empty,div.wrapper{width:130px}.player.active{background-color:#0d972b}.player.active.displayed{color:#000;height:93px}.playerLine span.title{display:inline-block;text-decoration:underline;width:45px}.pricing{background-color:#f8a48c}.r1{moz-transform:rotate(90deg);ms-transform:rotate(90deg);o-transform:rotate(90deg);transform:rotate(90deg);webkit-t