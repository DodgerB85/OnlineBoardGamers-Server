msgid ""
"Learning Game - See <a class='linkOther' href='/help/#navGameType'>Help</a>"
msgstr ""

#: .\templates\Lobby\lobby_icons.html:25
msgid ""
"Experienced Game - See <a class='linkOther' href='/help/#navGameType'>Help</"
"a>"
msgstr ""

#: .\templates\Lobby\lobby_icons.html:226
#: .\templates\Lobby\lobby_icons.html:234
#: .\templates\Lobby\lobby_icons.html:235
#: .\templates\Lobby\lobby_icons.html:320
#: .\templates\Lobby\lobby_icons.html:328
msgid "Selected gods"
