msgstr "Fecha"

#: .\RNB\templates\RNB\RNBhighScores.html:134
#: .\RNB\templates\RNB\RNBuserHighScores.html:97
msgid "Score"
msgstr "Puntaje"

#: .\RNB\templates\RNB\RNBhighScores.html:144
