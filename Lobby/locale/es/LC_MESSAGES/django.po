#: .\AQY\templates\AQY\AQYhelp.html:12
msgid ""
"Antiquity Rules Available <a class=\"linkOther\" href=\"https://tesera.ru/"
"images/items/188574/Antiquity_Rules.pdf\" target=\"_blank\" download>here</a>"
msgstr ""
"Reglas de antigüedad disponibles <a class=\"linkOther\" href=\"https://"
"tesera.ru/images/items/188574/Antiquity_Rules.pdf\" target=\"_blank\" "
