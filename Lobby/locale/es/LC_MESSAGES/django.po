msgstr "Mejoras de los ganadores (mediana)"

#: .\IND\templates\IND\INDstats.html:121
msgid "Others avg upgrades"
msgstr "Mejoras de los demás (media)"

#: .\IND\templates\IND\INDstats.html:122
