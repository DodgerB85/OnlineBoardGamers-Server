#: .\AQY\templates\AQY\AQYhelp.html:5
msgid "Antiquity Help"
msgstr "中世纪 帮助"

#: .\AQY\templates\AQY\AQYhelp.html:9 .\CNS\templates\CNS\CNShelp.html:9
#: .\DDL\templates\DDL\DDLhelp.html:9 .\IND\templates\IND\INDhelp.html:9
