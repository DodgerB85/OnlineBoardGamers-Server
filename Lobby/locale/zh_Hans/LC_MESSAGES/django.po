msgid "Enter username"
msgstr "输入用户名"

#: .\RNB\templates\RNB\RNBuserHighScores.html:86
#| msgid "Max Players"
msgid "Search Player"
msgstr "搜索玩家"

#: .\RNB\templates\RNB\RNBuserHighScores.html:87
msgid "All Highscores for"
msgstr "全部排行榜："

#: .\RNB\templates\RNB\RNBuserHighScores.html:88
msgid "Loading highscores..."
msgstr "加载排行榜…"

#: .\RNB\templates\RNB\RNBuserHighScores.html:108
msgid "No highscores recorded for this player yet."
msgstr "该玩家尚无排行榜记录。"

