#| msgid "Favourite Horseless Carriage Colour"
msgid "The Great Zimbabwe Help"
msgstr "The Great Zimbabwe 帮助"

#: .\TGZ\templates\TGZ\TGZhelp.html:17
#, python-format
msgid ""
"The Great Zimbabwe rules available <a href=\"%(rules_pdf)s\" "
"target=\"_blank\">here</a>"
msgstr "The Great Zimbabwe 规则见 <a href=\"%(rules_pdf)s\" target=\"_blank\">此处</a>"

#: .\TGZ\templates\TGZ\TGZhelp.html:22
#, python-format
msgid ""
"Fan made Schism Expansion rules available <a href=\"%(schism_pdf)s\" "
"target=\"_blank\">here</a>"
msgstr "粉丝 Schism 扩展规则见 <a href=\"%(schism_pdf)s\" target=\"_blank\">此处</a>"

#: .\TGZ\templates\TGZ\TGZhelp.html:27
msgid ""
"How to play guide example <a "
"href=\"https://www.youtube.com/watch?v=GMTNTNqvQyw\" "
