# Production Docker stack. Copy to .env on the server, then fill in the secrets.
# Never commit the filled-in file.

DEBUG=False
LOCAL_USER=False
LOCAL_USER_SQLITE3=False

# Public hostname seen by Django. Comma-separated.
ALLOWED_HOSTS="www.onlineboardgamers.com,onlineboardgamers.com"
CSRF_TRUSTED_ORIGINS="https://www.onlineboardgamers.com,https://onlineboardgamers.com"

# MySQL container. The stack maps these to PRODUCTION_DB_* for Django.
MYSQL_DATABASE=obs
MYSQL_USER=obg
MYSQL_PASSWORD="ADD_YOUR_DB_PASSWORD_HERE"
MYSQL_ROOT_PASSWORD="ADD_YOUR_DB_ROOT_PASSWORD_HERE"

# Host loopback port the bundled nginx publishes; the host TLS proxy targets it.
OBS_HTTP_PORT=8001

SEECRET_KEY_HOME_SERVER="ADD YOUR SECRET KEY HERE"
SECRET_KEY_PRODUCTION="ADD_YOUR_PRODUCTION_SECRET_KEY_HERE"
OBG_EMAIL_APP_PWD="ADD_YOUR_EMAIL_APP_PASSWORD_HERE"
OBG_EMAIL_HOST_USER="OnlineBoardGamers@gmail.com"
OBG_TURN1_EMAIL_HOST_USER="OnlineBoardGamers.turn1@gmail.com"
OBG_TURN2_EMAIL_HOST_USER="OnlineBoardGamers.turn2@gmail.com"
OBG_TURN3_EMAIL_HOST_USER="OnlineBoardGamers.turn3@gmail.com"
OBG_TURN4_EMAIL_HOST_USER="OnlineBoardGamers.turn4@gmail.com"
OBG_MAILER_EMAIL_HOST_USER="OnlineBoardGamers.mailer@gmail.com"
OBG_TURN1_EMAIL_APP_PWD="ADD_YOUR_TURN1_EMAIL_APP_PASSWORD_HERE"
OBG_TURN2_EMAIL_APP_PWD="ADD_YOUR_TURN2_EMAIL_APP_PASSWORD_HERE"
OBG_TURN3_EMAIL_APP_PWD="ADD_YOUR_TURN3_EMAIL_APP_PASSWORD_HERE"
OBG_TURN4_EMAIL_APP_PWD="ADD_YOUR_TURN4_EMAIL_APP_PASSWORD_HERE"
OBG_MAILER_EMAIL_APP_PWD="ADD_YOUR_MAILER_EMAIL_APP_PASSWORD_HERE"
MAIN_EMAIL_SERVER="MAIN_EMAIL_SERVER"
MAIN_EMAIL_LOGIN="MAIN_EMAIL_LOGIN"
MAIN_EMAIL_PWD="MAIN_EMAIL_PWD"

TELEGRAM_OBG_BOT_TOKEN="BOT_TOKEN"
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_WEBHOOK_PATH=my-secret-path/
WEBHOOK_ALL_ADMIN_REPORTS="ADD_YOUR_WEBHOOK_HERE"
WEBHOOK_DISCORD_UPDATES="ADD_YOUR_WEBHOOK_HERE"
WEBHOOK_DISCORD_TOURNAMENTS="ADD_YOUR_WEBHOOK_HERE"
WEBHOOK_BUG_REPORTS="ADD_YOUR_WEBHOOK_HERE"
WEBHOOK_FCM_TOURNAMENT_ADMIN="ADD_YOUR_WEBHOOK_HERE"
WEBHOOK_TGZ_TOURNAMENT_ADMIN="ADD_YOUR_WEBHOOK_HERE"

ADMIN_DB_KEY=1
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_REDIRECT_URI="https://www.onlineboardgamers.com/discord/callback/"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://www.onlineboardgamers.com/google/callback/"

# Production pages must load the committed vuedist bundles, not Vite servers.
AQY_USE_SOURCE_CODE=False
BUS_USE_SOURCE_CODE=False
CNS_USE_SOURCE_CODE=False
DDL_USE_SOURCE_CODE=False
FCM_USE_SOURCE_CODE=False
IND_USE_SOURCE_CODE=False
KFW_USE_SOURCE_CODE=False
LBR_USE_SOURCE_CODE=False
NTR_USE_SOURCE_CODE=False
RNB_USE_SOURCE_CODE=False
ROW_USE_SOURCE_CODE=False
TGZ_USE_SOURCE_CODE=False
URR_USE_SOURCE_CODE=False
WEB_USE_SOURCE_CODE=False
