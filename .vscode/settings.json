{
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "pattern": "./RNB/vueRNB/" },
    { "pattern": "./WEB/vueWEB/" },
    { "mode": "auto" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "vue"
  ],
  "eslint.run": "onType",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateInCurrentTerminal": true,

  // 👇 ADD THESE LINES BELOW TO FIX THE MULTI-FOLDER JS/TS RUNTIME
  "typescript.disableAutomaticTypeAcquisition": false,
  "javascript.implicitProjectConfig.checkJs": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true
  },
     "codeium.enableIndexService": false,
    "codeium.searchMaxWorkspaceFileCount": 100,
    "devin.searchMaxWorkspaceFileCount": 100,
    "python.languageServer": "None"
}